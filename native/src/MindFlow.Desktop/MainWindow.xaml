<Window x:Class="MindFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MindFlow.Desktop.ViewModels"
        mc:Ignorable="d"
        Title="MIND-FLOW // Cognitive Companion"
        Height="800" Width="1240"
        MinHeight="680" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextPrimaryBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left Sidebar -->
            <ColumnDefinition Width="240"/>
            <!-- Main Content Area -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==================== LEFT SIDEBAR ==================== -->
        <Border Grid.Column="0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Padding="24,28">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Brand Header -->
                    <RowDefinition Height="Auto"/>
                    <!-- Navigation Items -->
                    <RowDefinition Height="*"/>
                    <!-- Status / System Footnote -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,32">
                    <TextBlock Text="✦ MIND-FLOW"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Native Cognitive Companion"
                               FontFamily="{StaticResource AppFont}"
                               FontSize="12"
                               FontWeight="Medium"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <!-- Navigation List -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="🏠  Focus HUD"
                                 Style="{StaticResource NavButton}"
                                 IsChecked="True"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="dashboard"/>

                    <RadioButton Content="🧘  Zen Space"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="zen"/>

                    <RadioButton Content="📊  App Usage"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="analytics"/>

                    <RadioButton Content="⚙️  Preferences"
                                 Style="{StaticResource NavButton}"
                                 Command="{Binding NavigateCommand}"
                                 CommandParameter="preferences"/>
                </StackPanel>

                <!-- Footer Telemetry -->
                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <Border Background="{StaticResource SurfaceVariantBrush}"
                            CornerRadius="12"
                            Padding="12,10"
                            Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="NATIVE ENGINE"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentMintBrush}"
                                       Margin="0,0,0,2"/>
                            <TextBlock Text="Direct Win32 • Zero WebView"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="© 2026 ChaChan26"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <Grid Grid.Column="1" Margin="32,24,32,24">
            <Grid.RowDefinitions>
                <!-- Top Status Bar -->
                <RowDefinition Height="Auto"/>
                <!-- Dynamic Content Views -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Status Bar -->
            <Border Grid.Row="0" Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Active Window Info -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource SurfaceVariantBrush}"
                                CornerRadius="16"
                                Padding="14,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Active: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding ActiveProcessName}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource SurfaceVariantBrush}"
                                CornerRadius="16"
                                Padding="14,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Idle: " Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                                <TextBlock Text="{Binding IdleSeconds, StringFormat='{}{0:F1}s'}" FontWeight="SemiBold" FontSize="12"/>
                            </StackPanel>
                        </Border>

                        <!-- Audio Active Pill -->
                        <Border Background="#2B82C1B8"
                                CornerRadius="16"
                                Padding="12,6"
                                Margin="0,0,10,0">
                            <TextBlock Text="🔊 Audio Active"
                                       Foreground="{StaticResource AccentMintBrush}"
                                       FontWeight="SemiBold"
                                       FontSize="11"/>
                        </Border>
                    </StackPanel>

                    <!-- Mode Badge -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#2B8E97FD"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="16,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="MODE: " FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentModeName}"
                                           FontWeight="Bold"
                                           FontSize="13"
                                           Foreground="{StaticResource PrimaryBrush}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== DYNAMIC CONTENT VIEWS ==================== -->
            <Grid Grid.Row="1">
                <!-- 1. DASHBOARD VIEW -->
                <ScrollViewer Style="{StaticResource DashboardViewStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Hero Battery Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Battery Gauge Display -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Border Width="130" Height="130"
                                            CornerRadius="65"
                                            Background="#158E97FD"
                                            BorderBrush="{StaticResource PrimaryBrush}"
                                            BorderThickness="4"
                                            HorizontalAlignment="Center">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding BatteryCapacityFormatted}"
                                                       FontFamily="{StaticResource AppFont}"
                                                       FontSize="34"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Stamina"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{StaticResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- Battery Analytics & Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <TextBlock Text="Cognitive Battery Engine"
                                               FontSize="18"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Margin="0,0,0,6"/>
                                    <TextBlock Text="Real-time stamina modeling active. Battery depletion rate is dynamically adjusted for continuous strain and context switch friction."
                                               FontSize="13"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,16"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{StaticResource SurfaceVariantBrush}"
                                                CornerRadius="10"
                                                Padding="14,8"
                                                Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Consecutive Work" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding ConsecutiveWorkFormatted}" FontSize="15" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceVariantBrush}"
                                                CornerRadius="10"
                                                Padding="14,8"
                                                Margin="0,0,12,0">
                                            <StackPanel>
                                                <TextBlock Text="Switch Friction" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding SwitchFrictionText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentCoralBrush}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{StaticResource SurfaceVariantBrush}"
                                                CornerRadius="10"
                                                Padding="14,8">
                                            <StackPanel>
                                                <TextBlock Text="Engine Status" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentMintBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Quick Actions -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="170">
                                    <Button Content="⚡ Sprint (25m)"
                                            Style="{StaticResource PillButton}"
                                            Command="{Binding StartSprintCommand}"
                                            CommandParameter="25"
                                            Margin="0,0,0,10"/>

                                    <Button Content="Take Rest Break"
                                            Style="{StaticResource OutlineButton}"
                                            Command="{Binding TakeBreakCommand}"
                                            Margin="0,0,0,10"/>

                                    <Button Content="Extend Work (+5m)"
                                            Style="{StaticResource OutlineButton}"
                                            Command="{Binding ExtendSprintCommand}"
                                            CommandParameter="5"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Target Focus Sprint Timer Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Timer Countdown Box -->
                                <Border Grid.Column="0"
                                        Background="{StaticResource SurfaceVariantBrush}"
                                        CornerRadius="14"
                                        Padding="16,14"
                                        VerticalAlignment="Center">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TimerSessionLabel}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource AccentMintBrush}"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding TimerFormatted}"
                                                   FontFamily="{StaticResource AppFont}"
                                                   FontSize="32"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   HorizontalAlignment="Center"/>
                                        <ProgressBar Value="{Binding TimerProgress, Mode=OneWay}"
                                                     Minimum="0" Maximum="1"
                                                     Height="4"
                                                     Foreground="{StaticResource PrimaryBrush}"
                                                     Background="{StaticResource BorderBrush}"
                                                     BorderThickness="0"
                                                     Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Sprint Info & Presets -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <TextBlock Text="Target Focus Sprint" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="Autonomous intervals protect deep work momentum and lock out distracting notifications."
                                               FontSize="13" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="25m Pomodoro" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0"
                                                Command="{Binding StartSprintCommand}" CommandParameter="25"/>
                                        <Button Content="50m Deep Work" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0"
                                                Command="{Binding StartSprintCommand}" CommandParameter="50"/>
                                        <Button Content="90m Ultradian" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,8,0"
                                                Command="{Binding StartSprintCommand}" CommandParameter="90"/>
                                        <Button Content="5m Break" Style="{StaticResource OutlineButton}" Padding="12,6"
                                                Command="{Binding StartBreakTimerCommand}" CommandParameter="5"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Timer Controls -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="140">
                                    <Button Content="⏯ Toggle Timer"
                                            Style="{StaticResource PillButton}"
                                            Command="{Binding ToggleTimerCommand}"
                                            Margin="0,0,0,8"/>
                                    <Button Content="↺ Reset"
                                            Style="{StaticResource OutlineButton}"
                                            Command="{Binding ResetTimerCommand}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Two-Column Grid: Active Classification & Recent App Telemetry -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: Live Window Details & Context Friction -->
                            <Border Grid.Column="0" Style="{StaticResource CardPanel}" Margin="0,0,12,16">
                                <StackPanel>
                                    <TextBlock Text="Live Window Telemetry"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,16"/>

                                    <TextBlock Text="Active Process:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ActiveProcessName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentIndigoBrush}"
                                               Margin="0,2,0,14"/>

                                    <TextBlock Text="Window Caption:" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding ActiveWindowTitle}"
                                               FontSize="13"
                                               FontWeight="Medium"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,14"/>

                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Switches Today:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding TotalContextSwitches}" FontSize="15" FontWeight="Bold"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Switching Velocity:" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SwitchRatePerMin, StringFormat='{}{0:F1} / min'}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>

                                    <TextBlock Text="Manual Mode Override:" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Work" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0"
                                                Command="{Binding SetModeCommand}" CommandParameter="Work"/>
                                        <Button Content="Recharge" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0"
                                                Command="{Binding SetModeCommand}" CommandParameter="Recharge"/>
                                        <Button Content="Neutral" Style="{StaticResource OutlineButton}" Padding="12,6" Margin="0,0,6,0"
                                                Command="{Binding SetModeCommand}" CommandParameter="Neutral"/>
                                        <Button Content="Rest" Style="{StaticResource OutlineButton}" Padding="12,6"
                                                Command="{Binding SetModeCommand}" CommandParameter="Rest"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- Right: Today's App Usage Table -->
                            <Border Grid.Column="1" Style="{StaticResource CardPanel}" Margin="12,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Top Application Usage (Today)"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,16"/>

                                    <ItemsControl ItemsSource="{Binding RecentUsage}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderThickness="0,0,0,1"
                                                        BorderBrush="{StaticResource BorderBrush}"
                                                        Padding="0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Text="{Binding Process}"
                                                                   FontWeight="Medium"
                                                                   FontSize="13"/>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Duration, StringFormat='{}{0:F0}s'}"
                                                                   Foreground="{StaticResource TextMutedBrush}"
                                                                   FontSize="12"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- 2. ZEN SPACE VIEW -->
                <ScrollViewer Style="{StaticResource ZenViewStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40,0,40">
                        <TextBlock Text="🧘 Zen Sanctuary"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Parasympathetic 4-7-8 rhythmic breathing for sensory recovery."
                                   FontSize="14"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,32"/>

                        <!-- Pulsating Breathing Circle -->
                        <Border Width="220" Height="220"
                                CornerRadius="110"
                                Background="#1A8E97FD"
                                BorderBrush="{StaticResource PrimaryBrush}"
                                BorderThickness="3"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,32">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="{Binding BreathingScale}" ScaleY="{Binding BreathingScale}"
                                                CenterX="110" CenterY="110"/>
                            </Border.RenderTransform>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding BreathingPhaseText}"
                                           FontFamily="{StaticResource AppFont}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Button Content="Take 5m Rest Break"
                                    Style="{StaticResource PillButton}"
                                    Command="{Binding TakeBreakCommand}"
                                    Margin="0,0,12,0"/>
                            <Button Content="Return to Focus HUD"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="dashboard"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- 3. ANALYTICS & ENERGY VIEW -->
                <ScrollViewer Style="{StaticResource AnalyticsViewStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Hourly Productivity Breakdown -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Hourly Productivity Breakdown"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Aggregated time-series tracking classified minutes per hour today."
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Hour" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <TextBlock Grid.Column="1" Text="Work (m)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                                    <TextBlock Grid.Column="2" Text="Recharge (m)" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}"/>
                                    <TextBlock Grid.Column="3" Text="Deep Flow (m)" FontWeight="Bold" Foreground="{StaticResource AccentCoralBrush}"/>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding HourlyTrends}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderThickness="0,0,0,1"
                                                    BorderBrush="{StaticResource BorderBrush}"
                                                    Padding="0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="{Binding Hour, StringFormat='{}{0:D2}:00'}" FontWeight="Medium"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding WorkMinutes, StringFormat='{}{0:F1}'}" Foreground="{StaticResource PrimaryBrush}"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding RechargeMinutes, StringFormat='{}{0:F1}'}" Foreground="{StaticResource AccentMintBrush}"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding FlowMinutes, StringFormat='{}{0:F1}'}" Foreground="{StaticResource AccentCoralBrush}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Context Switching Velocity -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Cognitive Friction &amp; Context Switches"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="High-frequency process switching increases stamina drain and delays flow state onset."
                                           FontSize="13"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           Margin="0,0,0,16"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16" Margin="0,0,8,0">
                                        <StackPanel>
                                            <TextBlock Text="Total Switches" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding TotalContextSwitches}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="1" Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16" Margin="4,0,4,0">
                                        <StackPanel>
                                            <TextBlock Text="Switching Velocity" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SwitchRatePerMin, StringFormat='{}{0:F1} / min'}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource SecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16" Margin="8,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="Focus Friction Index" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SwitchFrictionText}" FontSize="15" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 4. PREFERENCES & CONFIG VIEW -->
                <ScrollViewer Style="{StaticResource PreferencesViewStyle}"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- Engine Configuration Card -->
                        <Border Style="{StaticResource CardPanel}">
                            <StackPanel>
                                <TextBlock Text="Native Engine Settings" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
                                <TextBlock Text="Hardware power governors, database concurrency, and startup behavior."
                                           FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,16"/>

                                <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Windows 11 EcoQoS Governor" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="Suppresses process power throttling for real-time WinEvent message pumps." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="ACTIVE" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="SQLite WAL Concurrency Queue" FontWeight="Bold" FontSize="14"/>
                                            <TextBlock Text="PRAGMA journal_mode=WAL with dedicated Channel worker thread." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="OPTIMAL" FontWeight="Bold" Foreground="{StaticResource AccentMintBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Background="{StaticResource SurfaceVariantBrush}" CornerRadius="12" Padding="16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
